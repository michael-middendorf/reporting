FROM python:3.12-alpine
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir 'boto3>=1.34.0' 'websockets>=12.0'
COPY services/publishers ./services/publishers
COPY functions ./functions
COPY docker/worker-entrypoint.py ./worker-entrypoint.py
RUN adduser -D -u 10001 reporting && chown -R reporting:reporting /app && chmod 1777 /tmp
ENV PYTHONPATH=/app/services/publishers:/app/services/publishers/common:/app/services/publishers/mas:/app/services/publishers/alumni:/app/services/publishers/institute:/app/services/publishers/housing
USER reporting
ENTRYPOINT ["python", "/app/worker-entrypoint.py"]
