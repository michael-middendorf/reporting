FROM python:3.12-alpine
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apk add --no-cache --upgrade su-exec openssl libssl3 libcrypto3 libuuid tzdata
# python-tds: pure-Python SQL Server driver (no native build on musl) for the
# read-only PowerCampus publisher. Pinned exactly; bump deliberately.
# pyOpenSSL: TLS for the PowerFAIDS and Great Plains SQL connections (common/mssql.py).
# cryptography ships musllinux wheels, so no native build is needed.
RUN pip install --no-cache-dir --upgrade 'pip>=26.2' \
 && python -c "import pip, re, sys; m = re.match(r'(\d+)\.(\d+)', pip.__version__); v = tuple(map(int, m.groups())) if m else (0, 0); sys.exit(0 if v >= (26, 2) else 1)" \
 && pip install --no-cache-dir 'boto3>=1.34.0' 'websockets>=12.0' 'python-tds==1.17.1' 'pyOpenSSL==26.4.0' \
 && python -c "import OpenSSL.SSL, pytds.tls; assert pytds.tls.OPENSSL_AVAILABLE, 'pyOpenSSL not usable by pytds'"
COPY services/publishers ./services/publishers
COPY docker/worker-entrypoint.py ./worker-entrypoint.py
COPY docker/worker-docker-entrypoint.sh /docker-entrypoint.sh
RUN adduser -D -u 10001 reporting && chown -R reporting:reporting /app && chmod +x /docker-entrypoint.sh
ENV PYTHONPATH=/app/services/publishers:/app/services/publishers/common:/app/services/publishers/mas:/app/services/publishers/alumni:/app/services/publishers/institute:/app/services/publishers/housing
USER reporting
ENTRYPOINT ["/docker-entrypoint.sh"]
